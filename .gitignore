__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.env
.DS_Store

outputs/
datasets/**/raw/
datasets/**/processed/
*.safetensors
*.ckpt
*.pt
*.bin

# Large LoRA / model assets live under models/, gitignored but layout preserved via models/README.md
models/loras/*
!models/loras/.gitkeep
!models/README.md

.ipynb_checkpoints/

# Local-only sidecars carrying personal context, release-timeline details,
# parallel-project references, and machine-specific paths. The public tracked
# CLAUDE.md / docs/context.md are sanitised versions; the .local.md files stay
# on the author's machine.
CLAUDE.local.md
docs/context.local.md
docs/planning/private/

# HuggingFace Hub upload staging area. Contains LoRA .safetensors + draft model
# cards before they are pushed to HF Hub. Not part of the public repo.
models/hf-staging/

# Playwright MCP runtime scratch (browser snapshots, console logs). Agent
# runtime artifact, not source. Not part of the public repo.
.playwright-mcp/

# Training-artifact captures (validation grids, manifests) from in-flight LoRA
# training. Ships publicly alongside the relevant LoRA release on HuggingFace
# Hub, not in this repo.
train-artifacts/

# Pitch materials, sketches, and ad-hoc spot-check outputs from the maintainer's
# private workflow. Not part of the public artifact.
pitch-materials/
local-spot-check/
soutine-after-*.png
soutine-before-*.png

# Bulk dataset content. The dataset-mosaic protocol's worked-example Python
# scripts under datasets/<name>/*.py ship publicly; image bytes, training ZIPs,
# manifests, gallery state, generated HTML, and rejected-image piles do not.
datasets/**/raw/
datasets/**/raw_orig/
datasets/**/rejected/
datasets/**/processed/
datasets/**/validation/
datasets/**/_civitai_staging/
datasets/**/gallery-state*
datasets/**/captions/
datasets/**/*.zip
datasets/**/*.csv
datasets/**/*.jpg
datasets/**/*.jpeg
datasets/**/*.png
datasets/**/*.json
datasets/**/*.html
datasets/**/*.txt

# --- agent-ops-harness ---
# The bundle at tools/agent-ops-harness/ and the runtime config ARE tracked: they are
# generic, MIT, and part of how this repo is worked on. What stays local:
#
# The priorities / ops-state files live under docs/planning/private/ (already ignored
# above). They carry release timing and work-in-progress state that the public
# workshop-facing repo should not ship.
#
# The ship-gate session hooks are wired in .claude/settings.local.json so they fire on
# the maintainer's machine only. A student cloning this repo gets no trunk-divergence
# banner and no hook they did not ask for.
.claude/settings.local.json

# --- workshop deck working material (2026-08-07) ---
# The deck lives in Canva; what lands on disk here is working scrap. deck-assets/
# additionally mixes workshop media with a personal portrait and stills from a
# separate project, so none of it ships from this public repo.
canva-*.png
canva-*.yml
slow-interpolation-workshop.pptx
renoir-dataset-mosaic.png
workshop-qr.png
deck-assets/

# --- generated ---
# Built by tools/gallery.py from whatever is in outputs/. Regenerate, never commit.
gallery.html

# Review notes the maintainer types into the render gallery and exports back to
# the repo root. Unreleased-work commentary, and on occasion a client or venue
# name. This repo is public. See docs/manual/render-gallery.md.
gallery-feedback.json

# Maintainer-local MCP servers (Canva, for the deck). Not part of the pipeline;
# a student cloning this repo should not be offered a Canva server.
.mcp.json

# Glance export: build artifact, regenerate with tools/glance_export.py
outputs/_glance/
outputs/_glance-renders/
outputs/_glance-deploy/

# --- media archive kit ---
tools/.env
tools/data/kb-export/
tools/data/media-vectors/
tools/media-engine/cache/
tools/media-engine/runs/
tools/media-engine/dist/
outputs/

# Glance dataset-mosaic sites: viewer payload + thumbnails derived from raw/ (image bytes stay out; rebuild with tools/mosaic-glance/build_mosaic_archive.py)
tools/mosaic-glance/site*/
